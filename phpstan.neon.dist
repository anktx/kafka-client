includes:
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: 8
    paths:
        - src
        - tests
        - bin

    ignoreErrors:
        # phpstan-phpunit помечает assertInstanceOf() с уже известным типом
        # как всегда истинный. В тестах такие проверки — легитимные smoke-тесты
        # («объект сконструировался»), правило оставлено активным для src/.
        -
            identifier: staticMethod.alreadyNarrowedType
            paths:
                - tests/*
