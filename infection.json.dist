{
    "$schema": "https://raw.githubusercontent.com/infection/infection/0.31.9/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ]
    },
    "logs": {
        "text": ".infection/log.txt",
        "summary": ".infection/summary.log",
        "debug": ".infection/debug.log",
        "perMutator": ".infection/per-mutator.md"
    },
    "mutators": {
        "@default": true,
        "MethodCallRemoval": false,
        "global-ignoreSourceCodeByRegex": [
            "\\$remainingMs = max\\(0, \\$timeoutMs - self::elapsedMs\\(\\$startedAtNs\\)\\);",
            "\\} while \\(self::elapsedMs\\(\\$startedAtNs\\) < \\$timeoutMs\\);",
            "return intdiv\\(hrtime\\(true\\) - \\$startedAtNs, 1_000_000\\);"
        ]
    },
    "testFramework": "phpunit",
    "testFrameworkOptions": "--testsuite=Unit",
    "phpUnit": {
        "configDir": "."
    },
    "threads": 10,
    "minMsi": 100,
    "minCoveredMsi": 100
}
